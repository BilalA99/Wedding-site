# Copy to .env.local and fill in values. Never commit real values.

# Supabase project URL (https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (safe for the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key — SERVER ONLY. Never expose to the client.
SUPABASE_SECRET_KEY=

# Comma-separated list of emails allowed into /admin
ADMIN_EMAILS=

# Canonical site URL (http://localhost:3000 in dev)
NEXT_PUBLIC_SITE_URL=
